{
  "manifest_version": 3,
  "name": "FonRota – Başvuru Formu Doldurucu",
  "short_name": "FonRota",
  "version": "1.4.0",
  "description": "FonRota hesabındaki firma bilgileriyle online başvuru formlarını tek tıkla doldurur. Formu göndermez; kontrol edip sen gönderirsin.",
  "default_locale": "tr",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "FonRota ile doldur",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "background": {
    "service_worker": "arkaplan.js"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "contextMenus",
    "webNavigation"
  ],
  "host_permissions": [
    "https://gebuzyferpvlzturxoyu.supabase.co/*",
    "*://*.gov.tr/*",
    "*://*.org.tr/*",
    "*://*.edu.tr/*",
    "*://*.bel.tr/*",
    "*://*.com.tr/*",
    "https://docs.google.com/forms/*",
    "https://forms.office.com/*",
    "https://tqr6dy7y9f-source.github.io/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://tqr6dy7y9f-source.github.io/fonrota/*",
        "http://localhost/*"
      ],
      "js": [
        "site.js"
      ],
      "run_at": "document_start"
    }
  ]
}
