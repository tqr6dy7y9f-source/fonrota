    <script>
        function changeIcon(item) {
            var i = $(item).find("i");
            if (i.hasClass("fa-arrow-circle-up")) {
                i.removeClass("fa-arrow-circle-up").addClass("fa-arrow-circle-down");
            }
            else {
                i.removeClass("fa-arrow-circle-down").addClass("fa-arrow-circle-up");
            }
        }
